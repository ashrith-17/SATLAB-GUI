{
  "name": "cansat-ground-station",
  "version": "1.0.0",
  "description": "Offline CanSat Ground Station GUI",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run build:electron -- --watch\" \"vite\" \"electron .\"",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc --project tsconfig.electron.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "keywords": ["cansat", "ground-station", "telemetry", "electron", "react", "echarts"],
  "author": "SATLAB",
  "license": "MIT",
  "dependencies": {
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialport": "^12.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "rimraf": "^5.0.7",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.satlab.cansatgroundstation",
    "productName": "CanSat Ground Station",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "dir",
      "sign": null,
      "signAndEditExecutable": false
    }
  }
}
